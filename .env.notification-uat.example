# Apply these values to an isolated DEV/UAT Amplify branch, then rebuild.
# Identity/core/payment/reporting env values stay as currently configured for UAT.
NEXT_PUBLIC_SHARED_NOTIFICATION_ENABLED=true
NEXT_PUBLIC_USE_PROXY=true
NEXT_PUBLIC_API_NOTIFICATION_PROXY=/api/proxy/notification
NOTIFICATION_API_URL=https://api.dev.ewallet.flexpay.vn/notification
NEXT_PUBLIC_SHARED_NOTIFICATION_API_URL=https://api.dev.ewallet.flexpay.vn/notification
EWA_NOTIFICATION_MANAGEMENT_URL=https://18.140.180.230:8082
NEXT_PUBLIC_EWA_NOTIFICATION_MANAGEMENT_API_URL=https://18.140.180.230:8082

# Production preparation: use the production ECS public host only after UAT.
# Keep NEXT_PUBLIC_SHARED_NOTIFICATION_ENABLED=false on current production.

# Web push (FCM) cho chuông thông báo CMS: Firebase project flexpay-1efe2 (cùng project
# với worker flexpay-notification). Lấy ở Firebase console > Project settings > General > Web app,
# và Cloud Messaging > Web Push certificates (VAPID key). Để trống thì CMS chỉ dùng polling.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=flexpay-1efe2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=flexpay-1efe2
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
