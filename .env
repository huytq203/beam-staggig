NEXT_PUBLIC_BEAM_API=https://api.dev.ewallet.flexpay.vn/identity
NEXT_PUBLIC_API_CORE=https://ewa-api.dev.ewallet.flexpay.vn/core
NEXT_PUBLIC_API_CORE2=https://ewa-api.dev.ewallet.flexpay.vn/reporting
NEXT_PUBLIC_API_PAYMENT=https://ewa-api.dev.ewallet.flexpay.vn/payment
NEXT_PUBLIC_BASE=https://dev.d42afkpbarff5.amplifyapp.com
NEXT_PUBLIC_API_NOTIFICATION=https://api.dev.ewallet.flexpay.vn/notification
NEXT_PUBLIC_API_MAINTENANCE = https://ofeyd8l1d6.execute-api.ap-southeast-1.amazonaws.com/v1/maintenance
# true = gọi API qua /api/proxy/* (chỉ chạy khi dev, tránh CORS), false = gọi thẳng backend (*_DIRECT)
NEXT_PUBLIC_USE_PROXY=true
# Proxy=true -> dùng *_PROXY (/api/proxy/<service>); Proxy=false -> dùng *_DIRECT (URL thật)
NEXT_PUBLIC_BEAM_API_DIRECT=https://api.dev.ewallet.flexpay.vn/identity
NEXT_PUBLIC_BEAM_API_PROXY=/api/proxy/beam-api
NEXT_PUBLIC_API_CORE_DIRECT=https://ewa-api.dev.ewallet.flexpay.vn/core
NEXT_PUBLIC_API_CORE_PROXY=/api/proxy/core
NEXT_PUBLIC_API_CORE2_DIRECT=https://ewa-api.dev.ewallet.flexpay.vn/reporting
NEXT_PUBLIC_API_CORE2_PROXY=/api/proxy/core2
NEXT_PUBLIC_API_PAYMENT_DIRECT=https://ewa-api.dev.ewallet.flexpay.vn/payment
NEXT_PUBLIC_API_PAYMENT_PROXY=/api/proxy/payment
NEXT_PUBLIC_API_NOTIFICATION_DIRECT=https://api.dev.ewallet.flexpay.vn/notification
NEXT_PUBLIC_API_NOTIFICATION_PROXY=/api/proxy/notification
NODE_ENV=test

# Verify JWT offline (withAuth.ts) bằng JWKS realm ewa-hr (thay IDENTITY_VERIFY_URL / KEYCLOAK_ISSUER cũ)
EWA_JWKS_URI=https://api.dev.ewallet.flexpay.vn/identity/api/v1/.well-known/jwks/ewa-hr
EWA_JWT_ISSUER=https://keycloak.dev.ewallet.flexpay.vn/realms/ewa-hr
NODE_TLS_REJECT_UNAUTHORIZED=0

