NEXT_PUBLIC_BEAM_API=https://identity.devops.beamewa.com.vn
NEXT_PUBLIC_API_CORE=https://core.devops.beamewa.com.vn
NEXT_PUBLIC_API_CORE2=https://report.devops.beamewa.com.vn
NEXT_PUBLIC_API_PAYMENT=https://payment.devops.beamewa.com.vn
NEXT_PUBLIC_API_NOTIFICATION=https://notification.devops.beamewa.com.vn
NEXT_PUBLIC_API_MAINTENANCE = https://ofeyd8l1d6.execute-api.ap-southeast-1.amazonaws.com/v1/maintenance
NEXT_PUBLIC_BASE=http://localhost:3001
NEXT_PUBLIC_SECRET=anything
# true = gọi API qua /api/proxy/* (chỉ chạy khi dev, tránh CORS), false = gọi thẳng backend (*_DIRECT)
NEXT_PUBLIC_USE_PROXY=true
# Proxy=true -> dùng *_PROXY (/api/proxy/<service>); Proxy=false -> dùng *_DIRECT (URL thật)
NEXT_PUBLIC_BEAM_API_DIRECT=https://identity.devops.beamewa.com.vn
NEXT_PUBLIC_BEAM_API_PROXY=/api/proxy/beam-api
NEXT_PUBLIC_API_CORE_DIRECT=https://core.devops.beamewa.com.vn
NEXT_PUBLIC_API_CORE_PROXY=/api/proxy/core
NEXT_PUBLIC_API_CORE2_DIRECT=https://report.devops.beamewa.com.vn
NEXT_PUBLIC_API_CORE2_PROXY=/api/proxy/core2
NEXT_PUBLIC_API_PAYMENT_DIRECT=https://payment.devops.beamewa.com.vn
NEXT_PUBLIC_API_PAYMENT_PROXY=/api/proxy/payment
NEXT_PUBLIC_API_NOTIFICATION_DIRECT=https://notification.devops.beamewa.com.vn
NEXT_PUBLIC_API_NOTIFICATION_PROXY=/api/proxy/notification
NODE_ENV=development


NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET= # Linux: `openssl rand -hex 32` or go to https://generate-secret.now.sh/32
KEYCLOAK_ID=beam-nextjs
KEYCLOAK_SECRET=flctBqVp9RAJcevqnEXV85ieMdvNiaIr
KEYCLOAK_ISSUER=https://testingapi.beamewa.com.vn:8443/realms/master


NODE_TLS_REJECT_UNAUTHORIZED=0
