generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model news_articles {
  id          String    @id @default("uuid()") @db.Char(36)
  title       String    @db.VarChar(255)
  slug        String    @unique(map: "slug") @db.VarChar(255)
  cover_image String?   @db.VarChar(512)
  description String?   @db.Text
  content     String?   @db.LongText
  ref         String?   @db.VarChar(512)
  is_hot_new  Boolean?  @default(false)
  tags        Json?
  shows       Boolean?  @default(true)
  status      String?   @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime? @db.DateTime(6)
  updated_at  DateTime? @db.DateTime(6)
  created_by  String?   @db.VarChar(50)
  updated_by  String?   @db.VarChar(50)

  @@index([slug], map: "idx_slug")
}

model images_control {
  id            String    @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name          String    @db.VarChar(255)
  url           String    @db.Text
  original_name String    @db.VarChar(255)
  file_type     String    @db.VarChar(100)
  user_id       String    @db.VarChar(36)
  created_at    DateTime? @default(now()) @db.DateTime(6)

  @@index([created_at], map: "idx_files_created_at")
  @@index([user_id], map: "idx_files_user_id")
}
